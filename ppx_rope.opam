opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_rope"
bug-reports: "https://github.com/public-release-reloaded/ppx_rope/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_rope.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_rope/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "dedent" {>= "v0.18~" & < "v0.19~"}
  "jane_rope" {>= "v0.18~" & < "v0.19~"}
  "ppx_string" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ppxlib" {>= "0.38.0"}
]
available: arch != "x86_32"
synopsis: "Ppx extension for string interpolation using ropes"
description: "
Construct ropes using using a PPX extension based on ppx_string
"
